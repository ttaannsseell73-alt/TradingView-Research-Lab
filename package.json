{
  "name": "tradingview-research-lab",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check:scripts": "node --check scripts/fetch-binance.mjs && node --check scripts/run-research.mjs && node --check scripts/run-acceptance.mjs && node --check scripts/final-local.mjs",
    "check": "npm run build && npm run check:scripts && npm test",
    "research": "npm run build && node scripts/run-research.mjs",
    "acceptance": "npm run build && node scripts/run-acceptance.mjs",
    "fetch:binance": "node scripts/fetch-binance.mjs",
    "final:local": "npm run build && node scripts/final-local.mjs",
    "final:local:publish": "npm run build && node scripts/final-local.mjs --publish"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
